# ──────────────────────────────────────────────
# @app/agent-api — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in values:
#   cp packages/agent-api/.env.example packages/agent-api/.env.local
# ──────────────────────────────────────────────

# Coinbase Developer Platform (CDP) credentials
# Get these from https://portal.cdp.coinbase.com
#
# 1. Create an API Key at   https://portal.cdp.coinbase.com/projects/api-keys
# 2. Generate Wallet Secret at https://portal.cdp.coinbase.com/wallets/non-custodial/security
CDP_API_KEY_ID=your-api-key-id
CDP_API_KEY_SECRET=your-api-key-secret
CDP_WALLET_SECRET=your-wallet-secret

# Network: "base-sepolia" (testnet, default) or "base" (mainnet)
NETWORK=base-sepolia

# Public URL of this service (used by x402 payment protocol)
# For local dev: http://localhost:3001
# For production: https://your-domain.com
URL=http://localhost:3001
